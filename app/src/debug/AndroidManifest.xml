<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <permission android:name="com.wangzan101.mika.rootprobe.permission.TRIGGER"
        android:protectionLevel="signature" />
    <application>
        <service android:name=".task.TaskService" android:exported="true"
            android:foregroundServiceType="specialUse" tools:node="replace" />
        <receiver android:name=".task.RootProbeReceiver" android:exported="true"
            android:permission="com.wangzan101.mika.rootprobe.permission.TRIGGER">
            <intent-filter>
                <action android:name="com.wangzan101.mika.ROOT_PROBE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
